pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "yourdockerhubusername/calculator-app"
        DOCKER_CREDENTIALS_ID = "docker-hub-credentials-id"   // Add your Docker Hub credentials in Jenkins
        KUBE_CONFIG_CREDENTIAL_ID = "kubeconfig-credentials-id" // Add kubeconfig file in Jenkins credentials
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${env.BUILD_NUMBER}", "-f docker/Dockerfile .")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKER_CREDENTIALS_ID) {
                        docker.image("${DOCKER_IMAGE}:${env.BUILD_NUMBER}").push()
                        docker.image("${DOCKER_IMAGE}:${env.BUILD_NUMBER}").push('latest')
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: KUBE_CONFIG_CREDENTIAL_ID, variable: 'KUBECONFIG')]) {
                    sh """
                    kubectl --kubeconfig=$KUBECONFIG set image deployment/calculator-deployment calculator-container=${DOCKER_IMAGE}:${env.BUILD_NUMBER} --record
                    kubectl --kubeconfig=$KUBECONFIG rollout status deployment/calculator-deployment
                    """
                }
            }
        }
    }
}
